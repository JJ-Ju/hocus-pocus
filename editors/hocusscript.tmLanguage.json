{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "HocusScript",
  "scopeName": "source.hocusscript",
  "fileTypes": [
    "hocus"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "match": "\\b(hocus)\\s+([0-9]+(?:\\.[0-9]+)*)",
      "captures": {
        "1": {
          "name": "keyword.control.version.hocusscript"
        },
        "2": {
          "name": "constant.numeric.version.hocusscript"
        }
      }
    },
    {
      "match": "\\b(graph|node|existing|adopt)\\b",
      "name": "storage.type.declaration.hocusscript"
    },
    {
      "match": "(@)(id)\\b",
      "captures": {
        "1": {
          "name": "punctuation.definition.annotation.hocusscript"
        },
        "2": {
          "name": "entity.name.function.annotation.hocusscript"
        }
      }
    },
    {
      "match": "\\b(target|category|mode|expect|revision|ownership|input|output|display|render|layout)\\b",
      "name": "keyword.other.hocusscript"
    },
    {
      "match": "\\b(merge|reconcile|auto)\\b",
      "name": "constant.language.hocusscript"
    },
    {
      "match": "\\b(true|false|null)\\b",
      "name": "constant.language.hocusscript"
    },
    {
      "match": "(?<![A-Za-z0-9_])-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?",
      "name": "constant.numeric.hocusscript"
    },
    {
      "begin": "\\b(vex)(`)",
      "beginCaptures": {
        "1": {
          "name": "entity.name.language.hocusscript"
        },
        "2": {
          "name": "punctuation.definition.string.begin.hocusscript"
        }
      },
      "end": "(?<!\\\\)(`)",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.string.end.hocusscript"
        }
      },
      "name": "meta.embedded.block.vex.hocusscript",
      "contentName": "source.vex",
      "patterns": [
        {
          "match": "\\\\`",
          "name": "constant.character.escape.backtick.hocusscript"
        },
        {
          "include": "source.vex"
        }
      ]
    },
    {
      "begin": "\\b(python)(`)",
      "beginCaptures": {
        "1": {
          "name": "entity.name.language.hocusscript"
        },
        "2": {
          "name": "punctuation.definition.string.begin.hocusscript"
        }
      },
      "end": "(?<!\\\\)(`)",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.string.end.hocusscript"
        }
      },
      "name": "meta.embedded.block.python.hocusscript",
      "contentName": "source.python",
      "patterns": [
        {
          "match": "\\\\`",
          "name": "constant.character.escape.backtick.hocusscript"
        },
        {
          "include": "source.python"
        }
      ]
    },
    {
      "begin": "\\b(hscript)(`)",
      "beginCaptures": {
        "1": {
          "name": "entity.name.language.hocusscript"
        },
        "2": {
          "name": "punctuation.definition.string.begin.hocusscript"
        }
      },
      "end": "(?<!\\\\)(`)",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.string.end.hocusscript"
        }
      },
      "name": "meta.embedded.block.hscript.hocusscript",
      "contentName": "source.shell",
      "patterns": [
        {
          "match": "\\\\`",
          "name": "constant.character.escape.backtick.hocusscript"
        },
        {
          "include": "source.shell"
        }
      ]
    },
    {
      "begin": "\\b([A-Za-z_][A-Za-z0-9_]*)(`)",
      "beginCaptures": {
        "1": {
          "name": "entity.name.language.hocusscript"
        },
        "2": {
          "name": "punctuation.definition.string.begin.hocusscript"
        }
      },
      "end": "(?<!\\\\)(`)",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.string.end.hocusscript"
        }
      },
      "name": "string.quoted.other.code.hocusscript",
      "patterns": [
        {
          "match": "\\\\`",
          "name": "constant.character.escape.backtick.hocusscript"
        }
      ]
    },
    {
      "include": "#strings"
    },
    {
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b",
      "name": "variable.other.hocusscript"
    },
    {
      "match": "[{}\\[\\](),;:.=]",
      "name": "punctuation.separator.hocusscript"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "begin": "//",
          "end": "$",
          "name": "comment.line.double-slash.hocusscript"
        },
        {
          "begin": "/\\*",
          "end": "\\*/",
          "name": "comment.block.hocusscript"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "begin": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.hocusscript"
            }
          },
          "end": "\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.hocusscript"
            }
          },
          "name": "string.quoted.double.hocusscript",
          "patterns": [
            {
              "match": "\\\\(?:[\"\\\\/bfnrt]|u[0-9A-Fa-f]{4})",
              "name": "constant.character.escape.hocusscript"
            }
          ]
        }
      ]
    }
  }
}
