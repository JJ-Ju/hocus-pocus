hocus 0.1;

graph exported_geo {
  target "/obj/geo1";
  category Sop;
  mode merge;
  expect revision 7;
  ownership "studio.environment.export";

  node sink @id("asset.sink-01"): "sink" {
    input[0] = source.output[1];
    snippet = vex`@P *= 2;`;
  }

  node source @id("asset.source-01"): "acme::source::1.0" {
    sx = 2;
  }

  display = sink;
  render = sink;
  output = sink;
}
