// context.vfl — detail wrangle, evidence scene only (not part of the asset). Ground context
// from the reference study: utility poles with overhead wires (19 of 30 photos), trees 0.5-0.9
// of a walk-up's height (15 of 30), parking with painted bays (7), bike shelters (8), lawns,
// green mesh fences, kerbs and patched asphalt. Uses the asset's generic materials by path.
// Spare parms: x0, x1 (extent along the block), zroad (road centre, south), seed.
function int prm(int pr; string mat; vector cd; float rough) {
    setprimattrib(0, "shop_materialpath", pr, chs("mats") + "/" + mat);
    setprimattrib(0, "Cd", pr, cd);
    setprimattrib(0, "rough", pr, rough);
    return pr;
}
function void box(vector mn; vector mx; string mat; vector cd; float rough) {
    int p = addbox(0, mn, mx, "ctx");
    for (int f = 0; f < 6; f++) prm(p + f, mat, cd, rough);
}
function void cyl(vector a; vector b; float r; int n; string mat; vector cd; float rough) {
    int p = cylm(0, a, b, r, n, mat, "own");
    for (int f = 0; f < n + 2; f++) prm(p + f, mat, cd, rough);
}
float x0 = chf("x0") - 30, x1 = chf("x1") + 30, zr = chf("zroad");
int seed = chi("seed");
// ground: lawn strip by the block, kerb, footpath, road, far verge; parking on the north side
box(set(x0, -0.3, -60), set(x1, -0.02, 60), "floor", {0.13, 0.13, 0.125}, 0.9);       // base asphalt
box(set(x0, -0.3, 5.4), set(x1, 0.02, zr - 6.5), "fabric", {0.10, 0.14, 0.06}, 0.95);   // lawn
box(set(x0, -0.3, zr - 6.5), set(x1, 0.12, zr - 4.5), "concrete", {0.70, 0.69, 0.66}, 0.85); // footpath
box(set(x0, -0.3, zr - 4.6), set(x1, 0.15, zr - 4.4), "concrete", {0.62, 0.62, 0.60}, 0.85); // kerb
box(set(x0, -0.3, zr + 4.4), set(x1, 0.15, zr + 4.6), "concrete", {0.62, 0.62, 0.60}, 0.85);
box(set(x0, -0.3, zr + 4.6), set(x1, 0.02, zr + 14), "fabric", {0.11, 0.14, 0.07}, 0.95);
// road surface patches and lines
for (int i = 0; i < 9; i++) {
    float px = lerp(x0, x1, rand(i * 3.3 + seed)), pz = zr + (rand(i * 1.7) - 0.5) * 6;
    float w = 1 + rand(i * 5.1) * 4, d = 0.6 + rand(i * 2.9) * 2.5;
    box(set(px, -0.02, pz), set(px + w, -0.012, pz + d), "floor", {0.09, 0.09, 0.088}, 0.85);
}
for (float x = x0; x < x1; x += 6) box(set(x, -0.02, zr - 0.06), set(x + 3, -0.01, zr + 0.06), "sign", {0.72, 0.70, 0.62}, 0.6);
box(set(x0, -0.02, zr - 4.2), set(x1, -0.01, zr - 4.1), "sign", {0.72, 0.72, 0.70}, 0.6);
// parking bays north of the block
for (float x = chf("x0") + 2; x < chf("x1") - 2; x += 2.5) box(set(x, -0.02, -20), set(x + 0.12, -0.01, -15), "sign", {0.72, 0.72, 0.70}, 0.6);
box(set(chf("x0") + 2, -0.02, -15.06), set(chf("x1") - 2, -0.01, -14.94), "sign", {0.72, 0.72, 0.70}, 0.6);
// green mesh fence along the lawn edge (posts + rails + a mesh card)
for (float x = x0; x < x1; x += 2.0) cyl(set(x, 0, zr - 6.6), set(x, 1.1, zr - 6.6), 0.025, 6, "steel", {0.10, 0.20, 0.12}, 0.5);
box(set(x0, 1.05, zr - 6.63), set(x1, 1.1, zr - 6.57), "steel", {0.10, 0.20, 0.12}, 0.5);
// utility poles every ~30 m on the far side of the footpath, three sagging wires
float pz = zr - 5.2;
vector tops[];
int np = 0;
for (float x = x0 + 8; x < x1; x += 28 + rand(np * 7.1) * 8) {
    np++;
    cyl(set(x, 0, pz), set(x, 11.5, pz), 0.17, 10, "concrete", {0.55, 0.55, 0.53}, 0.8);
    box(set(x - 0.06, 10.4, pz - 0.9), set(x + 0.06, 10.52, pz + 0.9), "steel", {0.25, 0.25, 0.24}, 0.5);
    box(set(x - 0.06, 9.4, pz - 0.7), set(x + 0.06, 9.5, pz + 0.7), "steel", {0.25, 0.25, 0.24}, 0.5);
    if (np % 2 == 0) cyl(set(x + 0.35, 8.0, pz), set(x + 0.35, 9.1, pz), 0.28, 10, "steel", {0.45, 0.46, 0.45}, 0.5);
    append(tops, set(x, 10.5, pz));
}
for (int i = 0; i + 1 < len(tops); i++) {
    for (int w = 0; w < 4; w++) {
        float off = w < 3 ? (w - 1) * 0.8 : 0.0;
        float yo = w < 3 ? 0.0 : -1.0;
        vector a = tops[i] + set(0, yo, off), b = tops[i + 1] + set(0, yo, off);
        int n = 12;
        for (int k = 0; k < n; k++) {
            float t0 = float(k) / n, t1 = float(k + 1) / n;
            float s0 = 4 * t0 * (1 - t0) * 0.6, s1 = 4 * t1 * (1 - t1) * 0.6;
            cyl(lerp(a, b, t0) - set(0, s0, 0), lerp(a, b, t1) - set(0, s1, 0), 0.012, 3, "plastic", {0.03, 0.03, 0.03}, 0.5);
        }
    }
}
// trees in the lawn: trunk, 3 levels of branches, leaf cards clustered at branch ends with gaps
int nt = 0;
for (float x = x0 + 12; x < x1 - 5; x += 14 + rand(nt * 3.7 + seed) * 12) {
    nt++;
    float tz = lerp(7.5, zr - 8.0, rand(nt * 5.9));
    float th = 8 + rand(nt * 2.3) * 6;
    vector base = set(x, 0, tz);
    vector top = base + set((rand(nt) - 0.5) * 0.6, th * 0.45, (rand(nt * 2) - 0.5) * 0.6);
    cyl(base, top, 0.18 + th * 0.012, 8, "room", {0.10, 0.08, 0.06}, 0.9);
    int nb = 7;
    for (int b = 0; b < nb; b++) {
        float ang = b * 2.39996 + rand(nt * 11 + b);
        float elev = 0.5 + rand(b * 3.1 + nt) * 0.6;
        vector dir = normalize(set(cos(ang), elev, sin(ang)));
        vector s0 = lerp(base, top, 0.7 + 0.3 * float(b) / nb);
        float bl = th * (0.25 + rand(b + nt * 5) * 0.2);
        vector e0 = s0 + dir * bl;
        cyl(s0, e0, 0.08, 6, "room", {0.10, 0.08, 0.06}, 0.9);
        for (int c = 0; c < 3; c++) {
            vector d2 = normalize(dir + set(rand(c + b * 7.0 + nt) - 0.5, rand(c * 1.3 + b) * 0.5, rand(c * 2.9 + b) - 0.5));
            vector e1 = e0 + d2 * bl * 0.45;
            cyl(e0, e1, 0.04, 5, "room", {0.10, 0.08, 0.06}, 0.9);
            // leaf cluster: 70 cards in an ellipsoid around e1, coloured by depth
            for (int l = 0; l < 220; l++) {
                vector o = set(rand(l * 1.1 + c + b * 3.0) - 0.5, rand(l * 2.3 + c) - 0.35, rand(l * 3.7 + b) - 0.5);
                o = normalize(o) * pow(rand(l * 4.4 + b), 0.5) * 0.5 * set(2.4, 1.6, 2.4);
                vector lc = e1 + o;
                float sz = 0.06 + rand(l * 5.3) * 0.06;
                vector u = normalize(set(rand(l + 0.11) - 0.5, rand(l + 0.27) - 0.3, rand(l + 0.33) - 0.5));
                vector v = normalize(cross(u, set(0.3, 1, 0.2)));
                float lr = rand(l * 9.1 + nt);
                vector cd = lerp({0.05, 0.10, 0.03}, {0.14, 0.22, 0.07}, lr);
                int pr = addprim(0, "poly", addpoint(0, lc - u * sz - v * sz * 0.5), addpoint(0, lc - u * sz + v * sz * 0.5), addpoint(0, lc + u * sz + v * sz * 0.5), addpoint(0, lc + u * sz - v * sz * 0.5));
                prm(pr, "fabric", cd, 0.7);
            }
        }
    }
}
// bike shelter by the main entrance on the north side: posts and a corrugated roof
float bx = chf("x0") + 10;
for (int i = 0; i < 5; i++) cyl(set(bx + i * 2.5, 0, -12.5), set(bx + i * 2.5, 2.2, -12.5), 0.04, 6, "steel", {0.6, 0.6, 0.58}, 0.5);
for (int k = 0; k < 40; k++) box(set(bx - 0.3, 2.2 + (k % 2) * 0.03, -14.5 + k * 0.06), set(bx + 10.3, 2.23 + (k % 2) * 0.03, -14.44 + k * 0.06), "steel", {0.16, 0.30, 0.45}, 0.45);
