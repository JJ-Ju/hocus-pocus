{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hocuspocus://schemas/hocus-module/v1",
  "title": "Decoded hocus.module.toml v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "library", "language", "entry_modules"],
  "properties": {
    "schema_version": {"const": 1},
    "library": {
      "type": "object", "additionalProperties": false,
      "required": ["uid", "version"],
      "properties": {
        "uid": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,127}$"},
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        }
      }
    },
    "language": {
      "type": "object", "additionalProperties": false,
      "required": ["version"],
      "properties": {"version": {"const": "0.2"}}
    },
    "entry_modules": {
      "type": "array", "minItems": 1, "maxItems": 4096, "uniqueItems": true,
      "items": {
        "type": "string", "minLength": 7, "maxLength": 1024,
        "pattern": "^(?=\\S)(?!.*\\s$)(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)(?!.*:)(?!.*//)(?!.*(?:^|/)[^/]*[ .](?:/|$))(?!.*(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.[^/]*)?(?:/|$))[^/]+(?:/[^/]+)*\\.hocus$"
      }
    }
  }
}
