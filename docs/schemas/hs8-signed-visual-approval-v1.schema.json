{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hocuspocus://schemas/hs8-signed-visual-approval/v1",
  "title": "HS8 Externally Signed Visual Approval v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "kind", "schemaVersion", "payload", "signatures"],
  "properties": {
    "$schema": {"const": "hocuspocus://schemas/hs8-signed-visual-approval/v1"},
    "kind": {"const": "hocus_hs8_signed_visual_approval"},
    "schemaVersion": {"const": 1},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorityRole",
        "canonicalization",
        "trustPolicy",
        "reviewRequestDigest",
        "reviewEvidenceDigest",
        "reviewEvidence",
        "issuedAt",
        "expiresAt"
      ],
      "properties": {
        "authorityRole": {"const": "visual_reviewer"},
        "canonicalization": {"const": "RFC8785"},
        "trustPolicy": {"$ref": "#/$defs/trustPolicy"},
        "reviewRequestDigest": {"$ref": "#/$defs/digest"},
        "reviewEvidenceDigest": {"$ref": "#/$defs/digest"},
        "reviewEvidence": {"$ref": "#/$defs/reviewEvidence"},
        "issuedAt": {"$ref": "#/$defs/timestamp"},
        "expiresAt": {"$ref": "#/$defs/timestamp"}
      }
    },
    "signatures": {"$ref": "#/$defs/signatures"}
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]*$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "trustPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policyId", "policyDigest"],
      "properties": {
        "policyId": {"$ref": "#/$defs/identifier"},
        "policyDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "reviewEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reviewVersion",
        "assetUri",
        "candidateProvenanceManifestDigest",
        "candidateOutputSetDigest",
        "visualComparisonDigest",
        "candidateVersionId",
        "reviewPolicyId",
        "reviewerPrincipalId",
        "decision",
        "notesDigest"
      ],
      "properties": {
        "kind": {"const": "hocus_visual_version_review_evidence"},
        "reviewVersion": {"const": 1},
        "assetUri": {
          "type": "string",
          "pattern": "^hocus-asset://[a-z0-9][a-z0-9._/-]{0,255}$"
        },
        "candidateProvenanceManifestDigest": {"$ref": "#/$defs/digest"},
        "candidateOutputSetDigest": {"$ref": "#/$defs/digest"},
        "visualComparisonDigest": {"$ref": "#/$defs/digest"},
        "candidateVersionId": {"$ref": "#/$defs/portableId"},
        "reviewPolicyId": {"$ref": "#/$defs/portableId"},
        "reviewerPrincipalId": {
          "type": "string",
          "pattern": "^(hocus-principal://[a-z0-9][a-z0-9._-]{0,127}|hprincipal_[0-9a-f]{32}|sha256:[0-9a-f]{64})$"
        },
        "decision": {"const": "approved"},
        "notesDigest": {
          "oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]
        }
      }
    },
    "portableId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["keyId", "algorithm", "signature"],
        "properties": {
          "keyId": {"$ref": "#/$defs/identifier"},
          "algorithm": {"const": "Ed25519"},
          "signature": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{86}$"
          }
        }
      }
    }
  }
}
