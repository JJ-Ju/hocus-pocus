{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hocuspocus://schemas/external-module-roots-inspection/v1",
  "title": "HocusScript External Module Roots Inspection v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind", "schemaVersion", "projectUid", "projectManifestDigest",
    "projectLockDigest", "catalogContentDigest", "catalogFingerprint",
    "libraries", "inspectionDigest"
  ],
  "properties": {
    "kind": {"const": "hocus-external-module-roots-inspection-v1"},
    "schemaVersion": {"const": 1},
    "projectUid": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,127}$"},
    "projectManifestDigest": {"$ref": "#/$defs/digest"},
    "projectLockDigest": {"$ref": "#/$defs/digest"},
    "catalogContentDigest": {"$ref": "#/$defs/digest"},
    "catalogFingerprint": {"$ref": "#/$defs/digest"},
    "libraries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/libraryRootPin"}
    },
    "inspectionDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "entryModule": {
      "type": "string",
      "minLength": 7,
      "maxLength": 1024,
      "pattern": "^(?=\\S)(?!.*\\s$)(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)(?!.*:)(?!.*//)(?!.*(?:^|/)[^/]*[ .](?:/|$))(?!.*(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.[^/]*)?(?:/|$))[^/]+(?:/[^/]+)*\\.hocus$"
    },
    "libraryRootPin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alias", "libraryUid", "libraryVersion", "moduleManifestDigest", "entryModules"
      ],
      "properties": {
        "alias": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
        "libraryUid": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,127}$"},
        "libraryVersion": {"$ref": "#/$defs/semver"},
        "moduleManifestDigest": {"$ref": "#/$defs/digest"},
        "entryModules": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/entryModule"}
        }
      }
    }
  }
}
