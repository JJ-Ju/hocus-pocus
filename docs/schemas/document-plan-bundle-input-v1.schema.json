{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hocuspocus://schemas/document-plan-bundle-input/v1",
  "title": "HocusScript Plan Bundle Input v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["bundle"],
  "properties": {
    "bundle": {
      "type": "object",
      "description": "A canonical resolved compiled-bundle v0.2, frozen Bundle v0.3, control Bundle v0.4, or value Bundle v0.5 object admitted through its exact version decoder.",
      "required": ["bundleVersion"],
      "properties": {
        "bundleVersion": {"enum": ["0.2", "0.3", "0.4", "0.5"]}
      }
    },
    "ttlSeconds": {"type": "integer", "minimum": 30, "maximum": 1800, "default": 900}
  }
}
