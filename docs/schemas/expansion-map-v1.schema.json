{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hocuspocus://schemas/expansion-map/v1",
  "title": "HocusScript Expansion Map v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "kind", "schemaVersion", "graphSpecVersion", "entrySourceUri", "stacks", "mappings"],
  "properties": {
    "$schema": {"const": "hocuspocus://schemas/expansion-map/v1"},
    "kind": {"const": "hocus_expansion_map"},
    "schemaVersion": {"const": 1},
    "graphSpecVersion": {"const": "0.3"},
    "entrySourceUri": {"$ref": "#/$defs/sourceUri"},
    "stacks": {
      "type": "array",
      "maxItems": 10000,
      "items": {"$ref": "#/$defs/stack"}
    },
    "mappings": {
      "type": "array",
      "maxItems": 100000,
      "items": {"$ref": "#/$defs/mapping"}
    }
  },
  "$defs": {
    "sourceUri": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "pattern": "^hocus-(?:project|module)://"
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line", "column", "offset"],
      "properties": {
        "line": {"type": "integer", "minimum": 1},
        "column": {"type": "integer", "minimum": 1},
        "offset": {"type": "integer", "minimum": 0}
      }
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceUri", "start", "end"],
      "properties": {
        "sourceUri": {"$ref": "#/$defs/sourceUri"},
        "start": {"$ref": "#/$defs/position"},
        "end": {"$ref": "#/$defs/position"}
      }
    },
    "instanceIdPath": {
      "type": "array",
      "maxItems": 64,
      "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["moduleUri", "sourceDigest", "moduleName", "instanceSymbol", "instanceIdPath", "importSpan", "useSpan"],
      "properties": {
        "moduleUri": {"$ref": "#/$defs/sourceUri"},
        "sourceDigest": {"$ref": "#/$defs/digest"},
        "moduleName": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "maxLength": 128},
        "instanceSymbol": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "maxLength": 128},
        "instanceIdPath": {"$ref": "#/$defs/instanceIdPath"},
        "importSpan": {"oneOf": [{"$ref": "#/$defs/span"}, {"type": "null"}]},
        "useSpan": {"$ref": "#/$defs/span"}
      }
    },
    "stack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stackId", "frames"],
      "properties": {
        "stackId": {"$ref": "#/$defs/digest"},
        "frames": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {"$ref": "#/$defs/frame"}
        }
      }
    },
    "relatedOrigin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "span"],
      "properties": {
        "role": {"enum": ["definition", "parameter_declaration", "argument", "export", "instance"]},
        "span": {"$ref": "#/$defs/span"}
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["originId", "generatedPointer", "originKind", "primarySpan", "relatedOrigins", "stackId"],
      "properties": {
        "originId": {"$ref": "#/$defs/digest"},
        "generatedPointer": {"type": "string", "pattern": "^(?:/(?:[^~/]|~0|~1)*)*$", "maxLength": 8192},
        "originKind": {"enum": ["definition", "argument", "export", "synthetic"]},
        "primarySpan": {"$ref": "#/$defs/span"},
        "relatedOrigins": {
          "type": "array",
          "maxItems": 16,
          "items": {"$ref": "#/$defs/relatedOrigin"}
        },
        "stackId": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}
      }
    },
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
