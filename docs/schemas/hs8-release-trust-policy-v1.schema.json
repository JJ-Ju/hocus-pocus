{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hocuspocus://schemas/hs8-release-trust-policy/v1",
  "title": "HS8 External Release Trust Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "kind",
    "schemaVersion",
    "policyId",
    "requireDistinctPrincipals",
    "roles"
  ],
  "properties": {
    "$schema": {"const": "hocuspocus://schemas/hs8-release-trust-policy/v1"},
    "kind": {"const": "hocus_hs8_release_trust_policy"},
    "schemaVersion": {"const": 1},
    "policyId": {"$ref": "#/$defs/identifier"},
    "requireDistinctPrincipals": {"const": true},
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cleanImageAttestor",
        "releaseDecisionAuthority",
        "visualReviewer"
      ],
      "properties": {
        "cleanImageAttestor": {"$ref": "#/$defs/role"},
        "releaseDecisionAuthority": {"$ref": "#/$defs/role"},
        "visualReviewer": {"$ref": "#/$defs/role"}
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]*$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimumSignatures", "keys"],
      "properties": {
        "minimumSignatures": {"type": "integer", "minimum": 1, "maximum": 8},
        "keys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {"$ref": "#/$defs/key"}
        }
      }
    },
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keyId",
        "principalId",
        "algorithm",
        "publicKey",
        "notBefore",
        "notAfter"
      ],
      "properties": {
        "keyId": {"$ref": "#/$defs/identifier"},
        "principalId": {"$ref": "#/$defs/identifier"},
        "algorithm": {"const": "Ed25519"},
        "publicKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "notBefore": {"$ref": "#/$defs/timestamp"},
        "notAfter": {"$ref": "#/$defs/timestamp"}
      }
    }
  }
}
