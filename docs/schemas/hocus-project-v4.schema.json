{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hocuspocus://schemas/hocus-project/v4",
  "title": "Decoded hocus.project.toml v4",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "language", "lock", "catalog"],
  "properties": {
    "schema_version": {"const": 4},
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uid"],
      "properties": {
        "uid": {"$ref": "#/$defs/projectUid"},
        "name": {
          "type": "string", "minLength": 1, "maxLength": 256,
          "pattern": "^(?=\\S(?:.*\\S)?$)[^\\u0000-\\u001F]+$"
        },
        "source_directories": {"$ref": "#/$defs/relativeDirectories"},
        "module_directories": {"$ref": "#/$defs/optionalRelativeDirectories"}
      }
    },
    "language": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version"],
      "properties": {"version": {"const": "0.3"}}
    },
    "lock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "path"],
      "properties": {
        "policy": {"const": "required"},
        "path": {"$ref": "#/$defs/jsonFile"}
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {"path": {"$ref": "#/$defs/jsonFile"}}
    },
    "external_aliases": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {"pattern": "^[a-z][a-z0-9-]{0,63}$"},
      "additionalProperties": {"$ref": "#/$defs/externalAlias"}
    }
  },
  "$defs": {
    "projectUid": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,127}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "externalAlias": {
      "type": "object", "additionalProperties": false,
      "required": ["library_uid", "version"],
      "properties": {
        "library_uid": {"$ref": "#/$defs/projectUid"},
        "version": {"$ref": "#/$defs/semanticVersion"},
        "module_manifest_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "portableRelativePath": {
      "type": "string", "minLength": 1, "maxLength": 1024,
      "pattern": "^(?=\\S)(?!.*\\s$)(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)(?!.*:)(?!.*//)(?!.*(?:^|/)[^/]*[ .](?:/|$))(?!.*(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.[^/]*)?(?:/|$))[^/]+(?:/[^/]+)*$"
    },
    "jsonFile": {
      "allOf": [{"$ref": "#/$defs/portableRelativePath"}, {"pattern": "\\.json$"}]
    },
    "directory": {
      "anyOf": [{"const": "."}, {"$ref": "#/$defs/portableRelativePath"}]
    },
    "relativeDirectories": {
      "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true,
      "items": {"$ref": "#/$defs/directory"}
    },
    "optionalRelativeDirectories": {
      "type": "array", "maxItems": 64, "uniqueItems": true,
      "items": {"$ref": "#/$defs/directory"}
    }
  }
}
