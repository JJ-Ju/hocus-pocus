{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hocuspocus://schemas/hocus-project/v2",
  "title": "Decoded hocus.project.toml v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "lock", "catalog"],
  "properties": {
    "schema_version": {"const": 2},
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uid"],
      "properties": {
        "uid": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,127}$"},
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^(?=\\S(?:.*\\S)?$)[^\\u0000-\\u001F]+$"
        },
        "source_directories": {"$ref": "#/$defs/relativeDirectories"}
      }
    },
    "language": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"version": {"const": "0.1"}}
    },
    "lock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "path"],
      "properties": {
        "policy": {"const": "required"},
        "path": {"$ref": "#/$defs/relativeFile"}
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {"path": {"$ref": "#/$defs/relativeFile"}}
    }
  },
  "$defs": {
    "portableRelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?=\\S)(?!.*\\s$)(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)(?!.*:)(?!.*//)[^/]+(?:/[^/]+)*$"
    },
    "relativeFile": {
      "allOf": [
        {"$ref": "#/$defs/portableRelativePath"},
        {"pattern": "\\.json$"}
      ]
    },
    "relativeDirectories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "description": "Entries are also required to be unique under case-folded semantic validation.",
      "items": {
        "anyOf": [
          {"const": "."},
          {"$ref": "#/$defs/portableRelativePath"}
        ]
      }
    }
  }
}
