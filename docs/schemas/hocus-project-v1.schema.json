{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hocuspocus://schemas/hocus-project/v1",
  "title": "Decoded hocus.project.toml v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project"],
  "properties": {
    "schema_version": {"const": 1},
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uid"],
      "properties": {
        "uid": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,127}$"},
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^(?=\\S(?:.*\\S)?$)[^\\u0000-\\u001F]+$"
        },
        "source_directories": {"$ref": "#/$defs/relativeDirectories"}
      }
    },
    "language": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"version": {"const": "0.1"}}
    },
    "lock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"policy": {"enum": ["optional", "required"]}}
    }
  },
  "$defs": {
    "relativeDirectories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "description": "Entries are also required to be unique under case-folded semantic validation.",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024,
        "pattern": "^(?:\\.|(?=\\S)(?!.*\\s$)(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)(?!.*:)(?!.*//)[^/]+(?:/[^/]+)*)$"
      }
    }
  }
}
