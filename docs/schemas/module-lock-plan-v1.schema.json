{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hocuspocus://schemas/module-lock-plan/v1",
  "title": "HocusScript Read-Only Module Lock Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "valid", "kind", "schemaVersion", "projectUid", "manifestDigest",
    "currentLockDigest", "prospectiveLockDigest", "catalogPath",
    "catalogContentDigest", "catalogFingerprint", "externalRootsInspectionDigest",
    "resolverPolicyDigest", "planDigest", "changed", "diffAvailable", "entries",
    "moduleCount", "modules", "diff"
  ],
  "properties": {
    "valid": {"const": true},
    "kind": {"const": "hocus-module-lock-plan-v1"},
    "schemaVersion": {"const": 1},
    "projectUid": {"$ref": "#/$defs/uid"},
    "manifestDigest": {"$ref": "#/$defs/digest"},
    "currentLockDigest": {"$ref": "#/$defs/digest"},
    "prospectiveLockDigest": {"$ref": "#/$defs/digest"},
    "catalogPath": {"$ref": "#/$defs/jsonFile"},
    "catalogContentDigest": {"$ref": "#/$defs/digest"},
    "catalogFingerprint": {"$ref": "#/$defs/digest"},
    "externalRootsInspectionDigest": {"$ref": "#/$defs/digest"},
    "resolverPolicyDigest": {"$ref": "#/$defs/digest"},
    "planDigest": {"$ref": "#/$defs/digest"},
    "changed": {"type": "boolean"},
    "diffAvailable": {"const": true},
    "entries": {
      "type": "array", "minItems": 1, "maxItems": 4096, "uniqueItems": true,
      "items": {"$ref": "#/$defs/entry"}
    },
    "moduleCount": {"type": "integer", "minimum": 0, "maximum": 4096},
    "modules": {
      "type": "array", "maxItems": 4096, "uniqueItems": true,
      "items": {"$ref": "#/$defs/module"}
    },
    "diff": {"$ref": "#/$defs/diff"}
  },
  "allOf": [
    {
      "if": {"properties": {"changed": {"const": false}}, "required": ["changed"]},
      "then": {
        "properties": {
          "diff": {
            "properties": {
              "addedUris": {"maxItems": 0},
              "removedUris": {"maxItems": 0},
              "changedUris": {"maxItems": 0}
            }
          }
        }
      },
      "else": {
        "properties": {
          "diff": {
            "anyOf": [
              {"properties": {"addedUris": {"minItems": 1}}},
              {"properties": {"removedUris": {"minItems": 1}}},
              {"properties": {"changedUris": {"minItems": 1}}}
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "uid": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,127}$"},
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "relativePath": {
      "type": "string", "minLength": 1, "maxLength": 1024,
      "pattern": "^(?=\\S)(?!.*[\\u0000-\\u001F\\u007F])(?!.*\\s$)(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)(?!.*:)(?!.*//)(?!.*(?:^|/)[^/]*[ .](?:/|$))(?!.*(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.[^/]*)?(?:/|$))[^/]+(?:/[^/]+)*$"
    },
    "jsonFile": {"allOf": [{"$ref": "#/$defs/relativePath"}, {"pattern": "\\.json$"}]},
    "hocusFile": {"allOf": [{"$ref": "#/$defs/relativePath"}, {"pattern": "\\.hocus$"}]},
    "moduleUri": {
      "type": "string", "minLength": 24, "maxLength": 8192,
      "pattern": "^hocus-(?:project|module)://[a-z0-9][a-z0-9.-]{0,127}/(?!(?:\\.|\\.\\.)(?:/|$))(?:[A-Za-z0-9._~-]|%(?!(?:[01][0-9A-F]|2[D-F]|3[0-9A]|4[1-9A-F]|5[0-9ACF]|6[1-9A-F]|7[0-9AEF]))[0-9A-F]{2})+(?:/(?!(?:\\.|\\.\\.)(?:/|$))(?:[A-Za-z0-9._~-]|%(?!(?:[01][0-9A-F]|2[D-F]|3[0-9A]|4[1-9A-F]|5[0-9ACF]|6[1-9A-F]|7[0-9AEF]))[0-9A-F]{2})+)*\\.hocus$"
    },
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["entryUri", "sourceDigest"],
      "properties": {
        "entryUri": {"allOf": [{"$ref": "#/$defs/moduleUri"}, {"pattern": "^hocus-project://"}]},
        "sourceDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "module": {
      "type": "object", "additionalProperties": false,
      "required": [
        "moduleUri", "projectUid", "libraryUid", "libraryVersion", "moduleManifestDigest",
        "languageVersion", "sourcePath", "contentDigest", "interfaceDigest", "transitiveDigest",
        "dependencies", "externalAlias"
      ],
      "properties": {
        "moduleUri": {"$ref": "#/$defs/moduleUri"},
        "projectUid": {"oneOf": [{"$ref": "#/$defs/uid"}, {"type": "null"}]},
        "libraryUid": {"oneOf": [{"$ref": "#/$defs/uid"}, {"type": "null"}]},
        "libraryVersion": {"oneOf": [{"$ref": "#/$defs/semver"}, {"type": "null"}]},
        "moduleManifestDigest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "languageVersion": {"const": "0.2"},
        "sourcePath": {"$ref": "#/$defs/hocusFile"},
        "contentDigest": {"$ref": "#/$defs/digest"},
        "interfaceDigest": {"$ref": "#/$defs/digest"},
        "transitiveDigest": {"$ref": "#/$defs/digest"},
        "dependencies": {
          "type": "array", "maxItems": 4096, "uniqueItems": true,
          "items": {"$ref": "#/$defs/moduleUri"}
        },
        "externalAlias": {
          "oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"}]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"externalAlias": {"type": "null"}}, "required": ["externalAlias"]},
          "then": {
            "properties": {
              "moduleUri": {"pattern": "^hocus-project://"},
              "projectUid": {"$ref": "#/$defs/uid"},
              "libraryUid": {"type": "null"},
              "libraryVersion": {"type": "null"},
              "moduleManifestDigest": {"type": "null"}
            }
          },
          "else": {
            "properties": {
              "moduleUri": {"pattern": "^hocus-module://"},
              "projectUid": {"type": "null"},
              "libraryUid": {"$ref": "#/$defs/uid"},
              "libraryVersion": {"$ref": "#/$defs/semver"},
              "moduleManifestDigest": {"$ref": "#/$defs/digest"}
            }
          }
        }
      ]
    },
    "uriList": {
      "type": "array", "maxItems": 4096, "uniqueItems": true,
      "items": {"$ref": "#/$defs/moduleUri"}
    },
    "diff": {
      "type": "object", "additionalProperties": false,
      "required": ["addedUris", "removedUris", "changedUris"],
      "properties": {
        "addedUris": {"$ref": "#/$defs/uriList"},
        "removedUris": {"$ref": "#/$defs/uriList"},
        "changedUris": {"$ref": "#/$defs/uriList"}
      }
    }
  }
}
