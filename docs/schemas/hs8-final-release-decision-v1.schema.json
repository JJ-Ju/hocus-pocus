{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hocuspocus://schemas/hs8-final-release-decision/v1",
  "title": "HS8 Externally Signed Final Release Decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "kind", "schemaVersion", "payload", "signatures"],
  "properties": {
    "$schema": {"const": "hocuspocus://schemas/hs8-final-release-decision/v1"},
    "kind": {"const": "hocus_hs8_final_release_decision"},
    "schemaVersion": {"const": 1},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorityRole",
        "canonicalization",
        "trustPolicy",
        "bindings",
        "cleanImageAttestationDigest",
        "releaseChannel",
        "decision",
        "issuedAt",
        "expiresAt"
      ],
      "properties": {
        "authorityRole": {"const": "release_decision_authority"},
        "canonicalization": {"const": "RFC8785"},
        "trustPolicy": {"$ref": "#/$defs/trustPolicy"},
        "bindings": {"$ref": "#/$defs/bindings"},
        "cleanImageAttestationDigest": {"$ref": "#/$defs/digest"},
        "releaseChannel": {"$ref": "#/$defs/identifier"},
        "decision": {"enum": ["approved", "rejected"]},
        "issuedAt": {"$ref": "#/$defs/timestamp"},
        "expiresAt": {"$ref": "#/$defs/timestamp"}
      }
    },
    "signatures": {"$ref": "#/$defs/signatures"}
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]*$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "trustPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policyId", "policyDigest"],
      "properties": {
        "policyId": {"$ref": "#/$defs/identifier"},
        "policyDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateDigest",
        "sourceSnapshotDigest",
        "installedPayloadManifestDigest",
        "runtimeDigest",
        "environmentReceiptDigest",
        "dependencySetDigest",
        "technicalQualificationReceiptDigest",
        "visualApprovalDigest"
      ],
      "properties": {
        "candidateDigest": {"$ref": "#/$defs/digest"},
        "sourceSnapshotDigest": {"$ref": "#/$defs/digest"},
        "installedPayloadManifestDigest": {"$ref": "#/$defs/digest"},
        "runtimeDigest": {"$ref": "#/$defs/digest"},
        "environmentReceiptDigest": {"$ref": "#/$defs/digest"},
        "dependencySetDigest": {"$ref": "#/$defs/digest"},
        "technicalQualificationReceiptDigest": {"$ref": "#/$defs/digest"},
        "visualApprovalDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["keyId", "algorithm", "signature"],
        "properties": {
          "keyId": {"$ref": "#/$defs/identifier"},
          "algorithm": {"const": "Ed25519"},
          "signature": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{86}$"
          }
        }
      }
    }
  }
}
